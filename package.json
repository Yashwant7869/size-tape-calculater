{
  "name": "size-tape-calculator",
  "version": "1.2.1",
  "description": "Privacy-first React clothing size calculator that estimates waist and apparel size from front and side photos in the browser.",
  "keywords": [
    "react",
    "react-component",
    "clothing-size",
    "size-calculator",
    "body-measurement",
    "waist-measurement",
    "fit-finder",
    "pose-detection",
    "tensorflowjs",
    "movenet",
    "computer-vision"
  ],
  "license": "UNLICENSED",
  "author": "Yashwant Singh Gour",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yashwant7869/size-tape-calculater.git"
  },
  "homepage": "https://github.com/Yashwant7869/size-tape-calculater#readme",
  "bugs": {
    "url": "https://github.com/Yashwant7869/size-tape-calculater/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSES",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite --host",
    "build": "node scripts/clean-dist.cjs && tsup && node scripts/fix-worker-url.cjs",
    "build:demo": "npm test && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "pack:check": "npm run typecheck && npm test && npm pack --dry-run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@tensorflow-models/pose-detection": "^2.1.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "tsup": "^8.3.5",
    "tsx": "^4.23.10",
    "typescript": "^5.6.0",
    "vite": "^7.1.0"
  },
  "packageManager": "npm@10.9.8",
  "publishConfig": {
    "access": "public"
  }
}
